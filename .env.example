# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Keys are only read by local Python scripts – the web app never sees them.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Question Radar (optional): Wikimedia asks for contact details in the
# User-Agent; Stack Exchange allows more requests with a free app key.
RADAR_USER_AGENT=
STACKEXCHANGE_KEY=

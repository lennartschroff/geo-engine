{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "questions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "nr", "text", "categories", "key", "schedule"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^q[0-9]+$" },
      "nr": { "type": "integer", "minimum": 1 },
      "text": { "type": "string", "minLength": 1 },
      "categories": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "key": { "type": "boolean" },
      "schedule": { "type": "string", "enum": ["weekly", "manual"] }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "blocks",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "categories", "source", "placeholder", "text_de", "text_en"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "type": {
        "type": "string",
        "enum": ["statement", "definition", "figure", "case", "quote", "faq"]
      },
      "categories": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      },
      "source": {
        "type": ["string", "null"],
        "description": "null = no real source yet (placeholder block)"
      },
      "placeholder": { "type": "boolean" },
      "text_de": { "type": "string", "minLength": 1 },
      "text_en": { "type": "string", "minLength": 1 }
    }
  }
}

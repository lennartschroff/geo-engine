{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "audit_actions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "priority", "effort", "status", "de", "en"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "priority": { "type": "string", "enum": ["low", "mid", "high"] },
      "effort": { "type": "string", "enum": ["low", "mid", "high"] },
      "status": { "type": "string", "enum": ["open", "done"] },
      "de": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 3,
        "maxItems": 3
      },
      "en": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
